{
  "name": "bevvip-next-concierge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run fix:ports && npm run build:hotel-points && npm run build:sea-routes && npm run build:cruise-regions",
    "build:hotel-points": "node scripts/build-hotel-points.mjs",
    "build:sea-routes": "node scripts/build-sea-routes.mjs",
    "build:cruise-regions": "node scripts/build-cruise-regions.mjs",
    "verify:cruise-regions": "node scripts/build-cruise-regions.mjs --check",
    "verify:atlas-regions": "node scripts/verify-atlas-regions.mjs",
    "verify:sea-routes": "node scripts/verify-sea-routes.mjs",
    "verify:adapters": "node scripts/verify-adapters.mjs",
    "harvest:expedition-ships": "node scripts/harvest-expedition-ships.mjs",
    "build:expedition-ships": "node scripts/build-expedition-ships.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "verify:deeplinks": "node scripts/verify-deeplinks.mjs",
    "verify:hotels": "node scripts/verify-hotels.mjs",
    "verify": "npm run check && npm run verify:adapters && npm run verify:deeplinks && npm run verify:hotels && npm run verify:offering-shape && npm run verify:intents && npm run verify:ports && npm run verify:sea-routes && npm run verify:route-order && npm run verify:cruise-regions && npm run verify:atlas-regions && npm run verify:ambient-tour && npm run verify:atlas-handoff",
    "verify:offering-shape": "node scripts/verify-offering-shape.mjs",
    "verify:intents": "node scripts/verify-intents.mjs",
    "verify:ambient-tour": "node scripts/verify-ambient-tour.mjs",
    "verify:atlas-handoff": "node scripts/verify-atlas-handoff.mjs",
    "verify:route-order": "node scripts/verify-route-order.mjs",
    "audit:ports": "node scripts/audit-port-locations.mjs",
    "fix:ports": "node scripts/fix-port-locations.mjs",
    "verify:ports": "node scripts/fix-port-locations.mjs --check && node scripts/audit-port-locations.mjs --strict"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0"
  }
}
